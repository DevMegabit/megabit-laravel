{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "devmegabit/megabit-laravel",
    "description": "Firebird database driver for Laravel 12 and 13, with migrations on Firebird 3, 4 and 5",
    "license": "MIT",
    "authors": [
        {
            "name": "Megabit Software LTDA"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "illuminate/support": "^12.17|^13.0",
        "illuminate/container": "^12.17|^13.0",
        "illuminate/database": "^12.17|^13.0",
        "illuminate/events": "^12.17|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5|^12.0",
        "orchestra/testbench": "^10.3|^11.0",
        "fakerphp/faker": "^1.24"
    },
    "archive": {
        "exclude": [
            "/tests"
        ]
    },
    "autoload": {
        "psr-4": {
            "Firebird\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Firebird\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-2.x": "2.x-dev"
        },
        "laravel": {
            "providers": [
                "Firebird\\FirebirdServiceProvider"
            ]
        }
    }
}
